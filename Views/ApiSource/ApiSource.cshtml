@model IEnumerable<ApiSource>
@{
    ViewData["ApiSource"] = "My Source";
}
<html lang="en">
    <head>
        <meta charset="utf-8" />
    </head>
    <body>
        <div class="text-center">
            <p>Boo!</p>
        </div>
    
        <table class="styled-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var api in Model)
                {
                    <tr>
                        <td>@api.Id</td>
                        <td>@api.Name</td>
                        <td>@api.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </body>
</html>
